{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "app": {
      "root": ".",
      "framework": "nextjs"
    },
    "tg-bot": {
      "root": "tg-bot",
      "runtime": "container",
      "bindings": [
        {
          "type": "service",
          "service": "app",
          "format": "url",
          "env": "APP_URL"
        }
      ]
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": {
        "service": "app"
      }
    }
  ]
}
