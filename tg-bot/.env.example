# =========================================================================
# FreshStream AI — Telegram Alert Bot Environment Configuration
# =========================================================================

# Telegram Bot API Token obtained from @BotFather
TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ_ExampleToken

# Target Telegram Chat ID (user ID or group/channel ID with minus prefix)
TELEGRAM_CHAT_ID=-1001234567890

# FreshStream AI Backend Base URL
BACKEND_URL=http://localhost:3000

# Polling interval in milliseconds if SSE disconnected
POLL_INTERVAL_MS=5000

# Alert Deduplication Cooldown in seconds (default: 300 = 5 minutes)
COOLDOWN_SECONDS=300
