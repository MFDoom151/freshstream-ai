# =========================================================================
# FreshStream AI — Production SaaS Environment Variables Template
# =========================================================================

# Database Configuration (SQLite local / PostgreSQL production)
# SQLite: file:./prisma/dev.db (local) or file:/app/prisma/dev.db (Docker)
# PostgreSQL: postgresql://user:password@localhost:5432/freshstream?schema=public
DATABASE_URL="file:./prisma/dev.db"

# NextAuth Authentication Configuration
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="freshstream-super-secret-jwt-encryption-key-min-32-chars-long"

# Telegram AI Conductor Alert Bot Configuration
# Bot token from @BotFather (optional for local dry-run testing)
TELEGRAM_BOT_TOKEN="123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ_ExampleToken"

# Telegram Target Chat ID (user or group/channel with minus sign)
TELEGRAM_CHAT_ID="-1001234567890"

# Service Interconnection Base URL
BACKEND_URL="http://localhost:3000"

# Application Environment
NODE_ENV="development"
